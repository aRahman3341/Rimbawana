# Salin jadi .env.local lalu isi (JANGAN di-commit). Nilai ada di Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA - hanya di .env.local dan Environment Variables Vercel (jangan pakai awalan NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
# Domain email teknis untuk login nama adat (ubah jika Supabase menolak)
EMAIL_DOMAIN_TEKNIS=anggota.invalid
# Alamat situs (untuk isi QR code label barang). Contoh: https://rimbawana.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
